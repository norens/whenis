{
  "name": "@whenis/core",
  "version": "0.1.1",
  "description": "Natural-language date parser for TypeScript — tokenizer + rule engine + resolver. Multi-candidate output, plugin-extensible, ESM + CJS.",
  "keywords": [
    "date",
    "dates",
    "datetime",
    "parser",
    "parsing",
    "natural-language",
    "nlp",
    "time",
    "typescript",
    "esm",
    "i18n"
  ],
  "homepage": "https://github.com/norens/whenis#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/norens/whenis.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/norens/whenis/issues"
  },
  "author": "Nazar Fedyshyn <me@nazarf.dev>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "luxon": "^3.5.0"
  },
  "devDependencies": {
    "@types/luxon": "^3.4.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
