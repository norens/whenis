{
  "name": "@whenis/locale-en",
  "version": "0.5.0",
  "description": "English locale for whenis — today/tomorrow/yesterday, next/this weekday, basic month-day forms and durations.",
  "keywords": [
    "date",
    "dates",
    "english",
    "en",
    "locale",
    "i18n",
    "nlp",
    "natural-language",
    "parser",
    "whenis"
  ],
  "homepage": "https://github.com/norens/whenis/tree/main/packages/locale-en#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/norens/whenis.git",
    "directory": "packages/locale-en"
  },
  "bugs": {
    "url": "https://github.com/norens/whenis/issues"
  },
  "author": "Nazar Fedyshyn <me@nazarf.dev>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@whenis/core": ">=0.1.1 <1.0.0"
  },
  "devDependencies": {
    "@whenis/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
